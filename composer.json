{
    "name": "kipchak/driver-cloudns",
    "type": "library",
    "description": "A ClouDNS driver for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "ClouDNS",
        "DNS",
        "Microservices",
        "Mamluk"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\ClouDns\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kipchak\\Driver\\ClouDns\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "kipchak/core": "^2 || ^3",
        "kipchak/driver-config": "^1",
        "kipchak/driver-http": "^1 || ^2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": "sample.config.php",
            "configName": "kipchak.cloudns.php",
            "initialise": "\\Kipchak\\Driver\\ClouDns\\ClouDns::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger",
                "kipchak/driver-http"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-cloudns"
        }
    }
}
